VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_DATABASE_ID=your-database-id
VITE_APPWRITE_COLLECTION_ID=chat_history

# Server-side only: set this in the Appwrite Function `chat-ai` environment.
# Never rename it to VITE_OPENAI_API_KEY — that would leak it in the browser bundle.
OPENAI_API_KEY=your-openai-key

# Server-side only: used by setup-db.js / seed-learning.js.
# Never rename it to VITE_APPWRITE_API_KEY.
APPWRITE_API_KEY=your-server-api-key
